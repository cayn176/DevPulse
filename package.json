{
  "name": "devpulse-desktop",
  "version": "0.3.1",
  "private": true,
  "description": "DevPulse unified AI developer workspace",
  "author": "DevPulse contributors",
  "license": "UNLICENSED",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop:dev": "electron .",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "node scripts/build-backend.cjs",
    "build:desktop": "npm run build:frontend && npm run build:backend && electron-builder --win --x64 --dir --publish never && node scripts/build-installer.cjs",
    "pack:desktop": "npm run build:frontend && npm run build:backend && electron-builder --dir --publish never",
    "build:store": "node scripts/store-package.cjs",
    "test:desktop": "node --test desktop/security.test.cjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.devpulse.workspace",
    "productName": "DevPulse",
    "copyright": "Copyright © 2026 DevPulse contributors",
    "asar": true,
    "files": ["desktop/**/*", "package.json"],
    "directories": { "output": "release", "buildResources": "desktop/assets" },
    "extraResources": [
      { "from": "backend/dist/windows-runtime", "to": "api", "filter": ["**/*"] },
      { "from": "frontend/dist", "to": "frontend", "filter": ["**/*"] }
    ],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "desktop/assets/icon.ico", "artifactName": "DevPulse-Offline-${version}-${arch}.${ext}", "signExecutable": false },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "deleteAppDataOnUninstall": false },
    "mac": { "icon": "desktop/assets/icon.icns", "target": "dmg", "category": "public.app-category.developer-tools" },
    "linux": { "target": "AppImage", "category": "Development" },
    "publish": null
  }
}
